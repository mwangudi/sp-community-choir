# ─── Database ───────────────────────────────────────────────
# mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/stpauls_choir"

# ─── Auth ───────────────────────────────────────────────────
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"
# How long an admin session lasts.
JWT_EXPIRES_IN="8h"

# ─── Site ───────────────────────────────────────────────────
# Baked into the client bundle at BUILD time — rebuild after changing it.
NEXT_PUBLIC_SITE_URL="https://stpauls-community-choir.vercel.app"
# Set to "false" to keep a deployment out of search engines.
NEXT_PUBLIC_ALLOW_INDEXING="true"

# ─── Uploads ──────────────────────────────────────────
# Leave unset on the droplet and in local dev — uploads then go to
# public/uploads/, which is symlinked to /var/lib/choir-uploads in production.
# Only set this if the app is hosted on Vercel, where the disk is read-only.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"

# ─── First admin (used by `npm run db:seed`) ─────────────────
# SEED_ADMIN_EMAIL="admin@example.org"
# SEED_ADMIN_PASSWORD="a-strong-one-time-password"